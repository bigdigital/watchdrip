<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <SwitchPreference
        android:defaultValue="false"
        android:key="miband_enable_xiaomi_service"
        android:summary="@string/summary_enable_xiaomi_service"
        android:title="@string/title_enable_xiaomi_service"
        app:iconSpaceReserved="false" />
    <Preference
        android:icon="@drawable/ic_pref_link"
        android:key="xiaomi_setup_guide"
        android:summary="@string/url_xiaomi_setup"
        android:title="@string/title_setup_guide">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="@string/url_xiaomi_setup" />
    </Preference>
</PreferenceScreen>
