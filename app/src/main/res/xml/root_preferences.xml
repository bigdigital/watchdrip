<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <SwitchPreference
        android:defaultValue="false"
        android:key="miband_enabled"
        android:summary="@string/summary_miband_enable"
        android:title="@string/title_miband_enable" />
    <PreferenceCategory
        android:key="category_integrations"
        android:title="@string/title_category_integrations">
        <Preference
            android:dependency="miband_enabled"
            android:fragment="com.thatguysservice.huami_xdrip.SettingsMiBandFragment"
            android:icon="@drawable/ic_pref_miband"
            android:key="screen_miband"
            android:title="@string/screen_miband" />
        <Preference
            android:dependency="miband_enabled"
            android:fragment="com.thatguysservice.huami_xdrip.SettingsZeppFragment"
            android:icon="@drawable/ic_pref_zepp"
            android:key="screen_zepp"
            android:title="@string/screen_zepp" />
        <Preference
            android:dependency="miband_enabled"
            android:fragment="com.thatguysservice.huami_xdrip.SettingsXiaomiFragment"
            android:icon="@drawable/ic_pref_xiaomi"
            android:key="screen_xiaomi"
            android:title="@string/screen_xiaomi" />
        <Preference
            android:dependency="miband_enabled"
            android:fragment="com.thatguysservice.huami_xdrip.SettingsGarminFragment"
            android:icon="@drawable/ic_pref_garmin"
            android:key="screen_garmin"
            android:title="@string/screen_garmin" />
        <Preference
            android:dependency="miband_enabled"
            android:fragment="com.thatguysservice.huami_xdrip.SettingsTelinkFragment"
            android:icon="@drawable/ic_pref_telink"
            android:key="screen_telink"
            android:title="@string/screen_telink" />
    </PreferenceCategory>
    <PreferenceCategory
        android:key="category_general"
        android:title="@string/title_category_general">
        <Preference
            android:dependency="miband_enabled"
            android:fragment="com.thatguysservice.huami_xdrip.SettingsDataFragment"
            android:icon="@drawable/ic_pref_data"
            android:key="screen_data"
            android:summary="@string/summary_screen_data"
            android:title="@string/screen_data" />
        <Preference
            android:fragment="com.thatguysservice.huami_xdrip.SettingsTroubleshootingFragment"
            android:icon="@drawable/ic_pref_troubleshooting"
            android:key="screen_troubleshooting"
            android:summary="@string/summary_screen_troubleshooting"
            android:title="@string/screen_troubleshooting" />
    </PreferenceCategory>
</PreferenceScreen>
